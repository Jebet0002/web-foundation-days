/* 1. Reset & General Styles */
*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: "Segoe UI", Arial, sans-serif;
  background-color: #f4f6f8;
  color: #222;
  line-height: 1.5;
}

/* 2. Header & Navigation */
header {
  background-color: #8e0000;
  color: white;
  text-align: center;
  padding: 24px 16px;
}

header h1 {
  margin: 0 0 12px 0;
}

nav ul {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  justify-content: center;
  gap: 16px;
}

nav a {
  color: white;
  text-decoration: none;
  font-weight: bold;
  padding: 6px 12px;
  border-radius: 4px;
  transition: background-color 0.2s ease, opacity 0.2s ease;
}

nav a:hover {
  background-color: rgba(255, 255, 255, 0.2);
  opacity: 0.9;
}

/* 3. Main Content & Cards Layout */
main {
  max-width: 640px;
  margin: 24px auto;
  padding: 0 16px;
}

section {
  background: white;
  padding: 20px;
  border-radius: 10px;
  margin-bottom: 20px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
}

/* 4. Responsive Features Grid (About Page) */
.features {
  list-style: none;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 16px;
}

.features li {
  background: #f9f9f9;
  border: 1px solid #ddd;
  padding: 16px;
  border-radius: 8px;
  text-align: center;
}

/* 5. Shortcuts Table Styles */
table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 10px;
}

th, td {
  border: 1px solid #ddd;
  padding: 10px;
  text-align: left;
}

th {
  background-color: #f0f0f0;
}

/* 6. Form Field Styles */
form div {
  margin-bottom: 12px;
}

form label {
  display: block;
  font-weight: bold;
  margin-bottom: 4px;
}

input, textarea, select {
  width: 100%;
  padding: 10px;
  border: 1px solid #ccc;
  border-radius: 6px;
  font-size: 1rem;
}

button {
  background-color: #0ba184;
  color: white;
  border: none;
  padding: 10px 18px;
  border-radius: 6px;
  font-size: 1rem;
  cursor: pointer;
  transition: background-color 0.2s ease, transform 0.2s ease;
}

button:hover {
  background-color: #088a70;
  transform: translateY(-2px);
}

/* 7. Footer */
footer {
  text-align: center;
  color: #777;
  padding: 16px;
}

/* 8. Media Query for Small Screens */
@media (max-width: 600px) {
  header {
    padding: 16px 12px;
  }

  header h1 {
    font-size: 1.5rem;
  }
}